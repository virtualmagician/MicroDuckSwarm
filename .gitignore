__pycache__/
*.pyc
.venv/
*.egg-info/

# Swift
.build/
.swiftpm/
xcuserdata/
DerivedData/

# macOS / Dropbox
.DS_Store
.dropbox

# Local run artifacts
*.intents.jsonl
/tmp/

# Pollen MicroDuck MJCF/meshes: CC BY-SA-NC, user-supplied, never committed
assets/microduck/

# Baked pose caches written by scripts/editor_server.py's Create Preview
# button / tools/bake (docs/viewer.md, docs/bake-format.md) -- build
# output, not authored content, so never under shows/ and never committed.
/bakes/

# Fleet and roster files: a list of duck addresses on a venue network, which
# is exactly the venue data CLAUDE.md rule 6 keeps out of a public repo. They
# live outside the checkout (docs/fleet.md): --fleet, then $DUCKSWARM_FLEET,
# then ~/.duckswarm/fleet.json. These patterns are the backstop for the copy
# someone drops in here anyway; python/tests/test_repo_hygiene.py is the gate.
fleet.json
*.fleet.json
roster.json
*.roster.json
/fleet/
!fleet.example.json

# Built launcher app (scripts/make_launcher_app.sh): build output, not source.
/dist/
